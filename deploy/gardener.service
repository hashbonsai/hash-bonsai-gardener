[Unit]
Description=Hash Bonsai Gardener (one round)
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=gardener
Group=gardener
WorkingDirectory=/opt/gardener
ExecStart=/usr/bin/node dist/gardener.mjs --config /etc/gardener/config.json

# The gardener reads its keys from /etc/gardener and writes only its state.
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/var/lib/gardener
