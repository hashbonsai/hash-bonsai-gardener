{
  "name": "hash-bonsai-gardener",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Writes Hash Bonsai's weekly report from chain facts, stores it on Walrus as an undeletable blob, and learns across epochs with Walrus Memory.",
  "license": "MIT",
  "scripts": {
    "build": "esbuild src/main.ts --bundle --platform=node --format=esm --target=node20 --outfile=dist/gardener.mjs",
    "once": "tsx src/main.ts",
    "approve": "tsx src/approve.ts",
    "reject": "tsx src/reject.ts",
    "backfill": "tsx scripts/backfill.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint src test scripts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.1.0",
    "@mysten-incubation/memwal": "^0.1.9",
    "@mysten/sui": "^2.37.0",
    "@mysten/walrus": "^1.2.36"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "esbuild": "~0.28.0",
    "oxlint": "^1.75.0",
    "tsx": "^4.20.0",
    "typescript": "~6.0.2",
    "vitest": "^4.1.10"
  }
}
